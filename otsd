import argparse
import logging
import os
import queue
import sys
import threading

import bitcoin
import bitcoin.core

import otsserver.calendar
import otsserver.rpc
import otsserver.stamper

parser = argparse.ArgumentParser(description="OpenTimestamps Server")

parser.add_argument("-q", "--quiet", action="count", default=0,
                    help="Be more quiet.")
parser.add_argument("-v", "--verbose", action="count", default=0,
                    help="Be more verbose. Both -v and -q may be used multiple times.")
parser.add_argument("-c", "--calendar", type=str,
                    dest='calendar_path',
                    default='~/.otsd/calendar',
                    help="Location of the calendar (default: '%(default)s')")

parser.add_argument("--rpc-port", type=int,
                    default=14788,
                    help="RPC port (default: %(default)d)")
parser.add_argument("--rpc-address", type=str,
                    default='localhost',
                    help="RPC address (default: %(default)s)")

parser.add_argument("--max-pending", type=int,
                    default=100000,
                    help="Maximum number of pending commitments to timestamp at a time (default: %(default)s)")

parser.add_argument("--btc-min-relay-feerate", metavar='FEERATE', type=float,
                    default=1,
                    help="Minimum relay feerate (default: %(default).1f sat/vB)")
parser.add_argument("--btc-conf-target", metavar='N', type=int,
                    default=1008,
                    help="Confirmation target for the first timestamp transaction (will be RBF-replaced if not mined)"
                         " (default: %(default)d)")
parser.add_argument("--btc-min-confirmations", metavar='N', type=int,
                    default=6,
                    help="Confirmations required before we save a Bitcoin timestamp permanently, must be greater than 1"
                         " (default: %(default)d)")
parser.add_argument("--btc-min-tx-interval", metavar='SECONDS', type=int,
                    default=60*60*6,
                    help="Minimum interval between timestamp transactions (default: %(default)d seconds)")
parser.add_argument("--btc-max-fee", metavar='FEE', type=float,
                    default=0.001,
                    help="Maximum transaction fee (default: %(default).3f BTC)")

btc_net_group = parser.add_mutually_exclusive_group()
btc_net_group.add_argument('--btc-testnet', dest='btc_net', action='store_const',
                           const='testnet', default='mainnet',
                           help='Use Bitcoin testnet rather than mainnet')
btc_net_group.add_argument('--btc-regtest', dest='btc_net', action='store_const',
                           const='regtest',
                           help='Use Bitcoin regtest rather than mainnet')

args = parser.parse_args()
args.parser = parser

# ~/.otsd exists only when the DEFAULT calendar path is in use — a custom
# --calendar must not leave a stray dotdir in the operator's home. stdout is
# the log (captured by docker/journald).
if args.calendar_path == parser.get_default('calendar_path'):
    default_dir = os.path.expanduser("~/.otsd")
    if not os.path.exists(default_dir):
        os.makedirs(default_dir)

logger = logging.getLogger('')
ch = logging.StreamHandler(sys.stdout)
logger.addHandler(ch)

args.verbosity = args.verbose - args.quiet

if args.verbosity == 0:
    logging.root.setLevel(logging.INFO)
elif args.verbosity > 0:
    logging.root.setLevel(logging.DEBUG)
elif args.verbosity == -1:
    logging.root.setLevel(logging.WARNING)
elif args.verbosity < -1:
    logging.root.setLevel(logging.ERROR)

if args.btc_net == 'testnet':
    bitcoin.SelectParams('testnet')
elif args.btc_net == 'regtest':
    bitcoin.SelectParams('regtest')

if not (1 <= args.btc_conf_target <= 1008):
    args.parser.error("--btc-conf-target must be in range 1 <= N <= 1008")

# Every flag is checked before a socket is bound or a worker started: a
# value refused inside the stamper's constructor would fail after the
# aggregator thread and the listener existed, and the non-daemon worker
# would keep a process alive behind a bound port that served nothing.
# argparse exits 2 with the message, nothing running.
if args.btc_min_confirmations < 2:
    args.parser.error("--btc-min-confirmations must be greater than 1")

exit_event = threading.Event()

calendar_path = os.path.expanduser(args.calendar_path)

calendar = otsserver.calendar.Calendar(calendar_path)

# Bind before any worker starts: a port that cannot be bound is a start
# that fails whole, exit 1, nothing left running; workers started first
# would keep a process alive, on their non-daemon threads, that served
# nothing. The aggregator is attached to the server once it exists.
try:
    server = otsserver.rpc.StampServer((args.rpc_address, args.rpc_port), None, calendar)
except OSError as exp:
    logging.critical("otsd: cannot bind %s:%d: %s; nothing was started, exiting 1"
                     % (args.rpc_address, args.rpc_port, exp))
    sys.exit(1)

# The workers, each starting its own thread. A constructor that raises
# after an earlier worker has started stops what started, closes the
# listener and exits 1: never a live process behind a bound port that
# serves nothing.
aggregator = None
try:
    aggregator = otsserver.calendar.Aggregator(calendar, exit_event)
    stamper = otsserver.stamper.Stamper(calendar, exit_event,
                                        args.btc_conf_target,
                                        args.btc_min_relay_feerate,
                                        args.btc_min_confirmations,
                                        args.btc_min_tx_interval,
                                        args.btc_max_fee * bitcoin.core.COIN,
                                        args.max_pending)
except Exception as exp:
    logging.critical("otsd: a worker could not be created (%s: %s); stopping what started, nothing served, exiting 1"
                     % (type(exp).__name__, exp))
    exit_event.set()
    server.server_close()
    if aggregator is not None:
        aggregator.thread.join(10)
    sys.exit(1)

calendar.stamper = stamper
server.attach_aggregator(aggregator)

# Serve until a worker stops the service or the operator does. A worker
# that fails past recovery (the aggregator's round did not commit, the
# stamper cannot start) sets exit_event: the listener is shut down, the
# workers joined, and the process exits 1 so the supervisor restarts it;
# never a dead worker behind a live port.
try:
    otsserver.rpc.serve_until_exit(server, exit_event, [aggregator.thread, stamper.thread])
except KeyboardInterrupt:
    exit_event.set()
    sys.exit(0)

failed = [name for name, worker in (('aggregator', aggregator), ('stamper', stamper))
          if getattr(worker, 'failure', None) is not None]
logging.critical("otsd: %s stopped the service; exiting 1 so the supervisor restarts it"
                 % (' and '.join(failed) or 'a worker'))
if any(worker.is_alive() for worker in (aggregator.thread, stamper.thread)):
    logging.critical("otsd: a worker thread is still alive after the join timeout; forcing the exit")
    logging.shutdown()
    os._exit(1)
sys.exit(1)

