# .env beside docker-compose.enterprise.yml (the appliance shape). Copy to
# .env, mode 600, fill in the RPC password. Never commit it.

# otsd's Bitcoin RPC, full URL including credentials. The user and password
# are the rpcauth line in bitcoin.conf (README, "The appliance shape", step
# 1); the wallet is the anchor wallet loaded there, otsd-island by
# convention; 8332 is mainnet's RPC port; host.docker.internal is the
# docker0 address bitcoind binds for the container.
BITCOIN_RPC_SERVICE_URL=http://otsd:replace-with-the-rpcauth-password@host.docker.internal:8332/wallet/otsd-island

# The coverage tier: seconds between anchor departures, jittered ×1–2.
# 21600 (default) = every 6–12 h; 3600 = every 1–2 h at roughly six times
# the anchoring spend. Cost of goods, not code.
# ANCHOR_INTERVAL_SECONDS=21600

# Host path for the calendar state instead of the named volume.
# OTSD_CALENDAR_DIR=/var/lib/otsd/calendar
